# Copy to .env to override the Docker Compose defaults.

# PostgreSQL owner role, used only by migrations and the demo seed.
POSTGRES_USER=higgsden
POSTGRES_PASSWORD=higgsden
POSTGRES_DB=higgsden

# Runtime role used by the API and workers. It has no BYPASSRLS, so row-level security applies.
APP_DB_USER=higgsden_app
APP_DB_PASSWORD=higgsden_app
OPERATOR_DB_PASSWORD=higgsden_operator

# Signs the session cookie.
SESSION_SECRET=change-me-in-any-shared-environment-0123456789

# Development-only demo sign-in. Never enable in a shared or production environment.
DEV_SIGN_IN=true

WEB_PORT=8080
API_PORT=3000
