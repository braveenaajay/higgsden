{
  "name": "@higgsden/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@higgsden/db": "workspace:*",
    "@higgsden/integrations": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "bullmq": "^6.3.17",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
