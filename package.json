{
  "name": "higgsden",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "db:generate": "pnpm --filter @higgsden/db generate",
    "db:migrate": "pnpm --filter @higgsden/db migrate",
    "db:seed": "pnpm --filter @higgsden/db seed",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "lint": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.15.0",
    "testcontainers": "^12.2.1",
    "turbo": "^2.11.9",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
