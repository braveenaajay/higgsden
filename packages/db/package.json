{
  "name": "@higgsden/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "test": "vitest run",
    "test:integration": "vitest run src/isolation.test.ts"
  },
  "dependencies": {
    "@higgsden/policy": "workspace:*",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
